##############################################################################
# nivabupa-api — configuration template
#
#   cp .env.example .env
#
# Every variable the service reads is listed here. The values below are the
# Niva Bupa UAT environment: copy this file as-is and the service runs against
# UAT, with the two exceptions marked REQUIRED near the bottom.
#
# ⚠️ FOR PRODUCTION: replace every value in the "NIVA BUPA" sections. Leaving a
# UAT endpoint in place while NODE_ENV=production is refused at startup
# (src/config/validate.js) rather than silently transacting against UAT.
#
# Anything omitted here falls back to src/config/defaults.js — which holds the
# same UAT values. That fallback exists so a newly-added variable that never
# reached a deployed .env keeps the service serving instead of erroring; it is
# not a substitute for configuring production properly. Startup logs name every
# value that came from the fallback table.
#
# Values are never printed to logs. Secrets are reported by name and length only.
##############################################################################

# ─── Runtime ────────────────────────────────────────────────────────────────
# development | uat | production
#   development → payment return URL and frontend URL default to localhost
#   production  → startup refuses to run against UAT endpoints
NODE_ENV=uat
PORT=4000

# Startup validation: 1 = refuse to start on any missing/fallback value,
# regardless of NODE_ENV. Production enforces this for UAT endpoints anyway.
STRICT_ENV=0

# Express `trust proxy`. Leave unset when the service faces clients directly.
# Set to 1 (or a subnet / hop count) behind nginx or a load balancer so req.ip
# is the buyer's address — it is recorded on journey events and payment callbacks.
# TRUST_PROXY=1

# ─── This service's own URLs ────────────────────────────────────────────────
# Where the payment callback 302s the buyer once it has decrypted the outcome.
FRONTEND_URL=http://localhost:5173
# SPA route appended to FRONTEND_URL, with the payment result as a query string.
FRONTEND_RETURN_PATH=/nivabupa-return

# '*' for any origin, or a comma-separated allow-list. Must permit PATCH and PUT
# — the journey endpoints use both.
#
# Entries are matched EXACTLY against the browser's Origin header, which is
# scheme + host + port and never carries a path. So the SPA's /all_health base
# must not appear here: "https://insurance.tommyandfurry.com/all_health" would
# match no request at all.
#
# ⚠️ The SPA and this API are on DIFFERENT hosts — the site is served from
# insurance.tommyandfurry.com while this API answers on
# healthinsurance.tommyandfurry.com — so every browser call is cross-origin and
# the site's origin MUST be listed. Omitting it does not fail loudly: the
# preflight still returns 204, just without an Access-Control-Allow-Origin
# header, and the browser reports a bare CORS error with nothing in this
# service's log.
#
# Deployed value (UAT — keep in sync with the server's .env):
#   NIVABUPA_CORS_ORIGINS=https://insurance.tommyandfurry.com,https://healthinsurance.tommyandfurry.com,http://localhost:5173,http://127.0.0.1:5173
#
# Left as '*' here because this template is copied for local runs, where the
# Vite dev server's origin varies.
NIVABUPA_CORS_ORIGINS=*

# Second mount point serving every route a second time, for frontend builds
# whose base URL still ends in /health. Set empty to disable.
NIVABUPA_ALIAS_PREFIX=/health

# ─── NIVA BUPA — generic API (token / premium / uwDecision / datapush) ──────
# OAuth2 client_credentials. REPLACE ALL FOR PRODUCTION.
NIVABUPA_CLIENT_ID=cdceaca20073415586ed9e28c7337ae1
NIVABUPA_CLIENT_SECRET=idcscs-91476a29-94d2-494f-bbb4-990c28984050
NIVABUPA_IDENTIFIER_CODE=BR08860001
NIVABUPA_SCOPE=https://uat.nbhi.ohi.ocs.oraclecloud.com/uat/urn::ohi-components-apis

NIVABUPA_TOKEN_URL=https://digitaluat.nivabupa.com/api/generic/token
NIVABUPA_PREMIUM_URL=https://digitaluat.nivabupa.com/api/generic/premium
NIVABUPA_UW_DECISION_URL=https://digitaluat.nivabupa.com/api/generic/uwDecision
NIVABUPA_DATAPUSH_URL=https://digitaluat.nivabupa.com/api/generic/datapush

# Dumps full upstream request/response bodies to stdout. Leave off: these carry
# PAN, DOB and medical answers, and pm2 keeps stdout on disk indefinitely.
# Failures are logged in full regardless of this flag.
NIVABUPA_DEBUG=0

# ─── NIVA BUPA — Case API (proposal status / policy download) ───────────────
# Separate host prefix, separate credential pair, token goes in an `access_token`
# header rather than `Authorization`.
NIVABUPA_CASEAPI_TOKEN_URL=https://digitaluat.nivabupa.com/caseapi/api/auth/v1/getauthtoken
NIVABUPA_PROPOSAL_STATUS_URL=https://digitaluat.nivabupa.com/caseapi/api/common/getpreissuancestatus
NIVABUPA_POLICY_DOWNLOAD_URL=https://digitaluat.nivabupa.com/caseapi/api/document/getalldocument

# REQUIRED — no bundled fallback. Niva Bupa ship no sample values for these two
# ("Partner specific to be shared separately on mail"). Without them,
# /nivabupa/proposal-status and /nivabupa/policy-download fail with a named
# error; everything else still works.
NIVABUPA_CASEAPI_USER_ID=
NIVABUPA_CASEAPI_CLIENT_ID=

# ─── NIVA BUPA — payment ────────────────────────────────────────────────────
# Juspay-backed gateway page the frontend auto-submits an HTML form POST to.
NIVABUPA_PAYMENT_GATEWAY_URL=https://paymbhid.nivabupa.com/Pages/getPaymentValues.aspx
# WCF SOAP service that encrypts the outbound querystring (encResp) and decrypts
# the return callback (decResp).
NIVABUPA_SOAP_URL=https://uat-transactions.nivabupa.com/websiteService/Service1.svc
NIVABUPA_PAYMENT_ENCRYPTION_KEY=nivabupauat@(!!*()@
NIVABUPA_PAYMENT_DECRYPTION_KEY="!max#bupa@"

# OURS, not Niva Bupa's: the URL their gateway returns the buyer to. This value
# is registered with Niva Bupa and their gateway may validate it — a URL they do
# not hold can be rejected at the gateway. Local runs work because the gateway
# returns the buyer by auto-submitting a form POST from their own browser.
NIVABUPA_PAYMENT_RETURN_URL=http://localhost:4000/nivabupa/payment/return
# Production:
# NIVABUPA_PAYMENT_RETURN_URL=https://ondc.healthinsurance.tommyandfurry.com/health/nivabupa/payment/return

# Gateway contract values applied to every payment/initiate body.
NIVABUPA_PAYMENT_TYPE=mxbpofflinewithoutemi
NIVABUPA_PAYMENT_ISJUSPAY=yes

# ─── NIVA BUPA — proposal channel identity ──────────────────────────────────
# Asserted on every UW Decision and Data Push payload. Niva Bupa can reassign
# the branch and agent codes per partner.
NIVABUPA_LOGIN_BRANCH_CODE=511101
NIVABUPA_NOC_BRANCH_CODE=511101
NIVABUPA_AGENT_CODE=BR08860001
# OL = collected online (every Juspay payment).
NIVABUPA_PAYMENT_COLLECT_MODE=OL
# Data Push only runs after a SUCCESS callback, so the money is always in by then.
NIVABUPA_PAYMENT_RECEIVED_FLAG=Y

# ─── Timeouts (milliseconds, per attempt) ───────────────────────────────────
NIVABUPA_TOKEN_TIMEOUT_MS=15000
NIVABUPA_API_TIMEOUT_MS=20000
NIVABUPA_SOAP_TIMEOUT_MS=20000
# Data Push writes a proposal and can hand it to a manual NSTP workflow — it has
# been measured still not answering at 20s. Payment has already been taken by
# then, so waiting beats giving up and not knowing whether the proposal exists.
# Keep this UNDER the frontend's own axios timeout (60s) so this server is what
# gives up first and can report why.
NIVABUPA_DATAPUSH_TIMEOUT_MS=55000

##############################################################################
# IFFCO TOKIO (ITGI) — Partner Health (FHP / IHP)
#
# OPTIONAL. Leave the four variables below empty and the /iffcotokio endpoints
# answer 503 naming what is missing; nothing else in this service is affected
# and Niva Bupa keeps working exactly as before.
#
# ⚠️ UNLIKE the Niva Bupa section above, there are NO bundled fallbacks for any
# of this. src/config/defaults.js contains no ITGI host, credential or partner
# code and must never contain one — a process that was not given them cannot
# reach ITGI at all, which is the point: there is no way to accidentally
# transact against ITGI staging from production.
#
# UAT → PRODUCTION is these four variables and nothing else:
#   ITGI_BASE_URL, ITGI_USERNAME, ITGI_PASSWORD, ITGI_PARTNER_CODE
# (plus ITGI_PAYMENT_RETURN_URL, which is ours — see below.) No source change.
##############################################################################

# The ITGI host. Everything else is a path appended to it, so this ONE value
# moves the whole integration between environments.
#   UAT / staging : the staging host ITGI gave you (staging.iffcotokio.co.in)
#   Production    : the production host ITGI give you
# Startup REFUSES to run when NODE_ENV=production and this still looks like
# UAT/staging (src/config/validate.js) rather than silently going live on it.
ITGI_BASE_URL=

# HTTP Basic credentials, issued by ITGI and shared separately. Never commit a
# real value here — this file is a template and is tracked in git.
ITGI_USERNAME=
ITGI_PASSWORD=

# Our partner code with ITGI (e.g. the UAT one issued for this integration).
# Sent as partnerDetail.partnerCode on every request, and the key ITGI hold the
# payment response URL against — so it changes between UAT and production.
ITGI_PARTNER_CODE=

# ─── ITGI — payment ─────────────────────────────────────────────────────────
# ⚠️ OURS, not ITGI's, and the single most important value in this section.
#
# ITGI take the premium on their own hosted page and issue the policy
# themselves — partner-end collection is disabled for our partner code — so
# they redirect the buyer back to a URL REGISTERED ON THEIR SIDE:
#
#   <this URL>?ITGIResponse=product|orderNo|traceNo|policyNo|premium|SUCCESS
#
# That redirect is the ONLY channel by which a policy number reaches this
# service. It must end in /iffcotokio/payment/return, which is the route this
# service serves, and it must match what ITGI hold — ask them to update it when
# it changes. Six live UAT payments were lost on 2026-08-26 because the
# registered URL had no handler behind it.
#
# This service never sends this value anywhere; it is here so startup can check
# it against the route actually served and warn loudly when they disagree.
#
# UAT (registered with ITGI):
#   ITGI_PAYMENT_RETURN_URL=https://healthinsurance.tommyandfurry.com/health/iffcotokio/payment/return
# Local:
#   ITGI_PAYMENT_RETURN_URL=http://localhost:4000/iffcotokio/payment/return
ITGI_PAYMENT_RETURN_URL=

# SPA route the payment return 302s the buyer to, appended to FRONTEND_URL with
# the outcome (including the policy number) as a query string.
#
# MUST match the route the frontend actually declares. The ONDC_Health_Project
# SPA registers "/itgi-return" (src/App.jsx), so that is the value to use — a
# mismatch lands a paid buyer on the SPA's 404 and throws away the policy
# number, which reaches us through this redirect and nowhere else.
ITGI_FRONTEND_RETURN_PATH=/itgi-return

# The hosted gateway page the browser is POSTed to. Leave empty: it is derived
# from ITGI_BASE_URL, and ITGI return the same URL on the proposal response
# (itgiPaymentUrl), which is preferred over both. Set only if ITGI ever host the
# gateway somewhere other than the API base.
# ITGI_PAYMENT_GATEWAY_URL=

# ─── ITGI — behaviour ───────────────────────────────────────────────────────
# FHP (family floater, one policy-level sum insured) or IHP (individual, one
# per member). Applied when a request sends no contractType.
ITGI_CONTRACT_TYPE=FHP

# Retries on transport failures and 502/503/504 only, and never on the proposal,
# the payment confirmation or a CKYC create — those are not idempotent.
ITGI_MAX_RETRIES=2

# Per-attempt HTTP budgets, milliseconds. CKYC create gets its own: it was
# measured at 44 SECONDS on staging against ~1s for the health calls, and a
# timeout there costs the customer their document uploads.
ITGI_API_TIMEOUT_MS=60000
ITGI_CKYC_CREATE_TIMEOUT_MS=120000

# CKYC create carries base64 document uploads, which do not fit the 100kb
# express.json default the Niva Bupa routes use.
ITGI_JSON_BODY_LIMIT=6mb

# Dumps full upstream request/response bodies to stdout. Leave off: proposal and
# CKYC bodies carry PAN, Aadhaar, DOB, medical answers and document scans.
# Failures are logged in full regardless of this flag.
ITGI_DEBUG=0

# Defaults to NIVABUPA_CORS_ORIGINS. Set only to give ITGI a different list.
# ITGI_CORS_ORIGINS=

# Request paths appended to ITGI_BASE_URL. These are the API CONTRACT and are
# identical in UAT and production — they are listed here only so an ITGI-side
# path change stays a .env edit rather than a release. Leave them commented out.
# ITGI_PREMIUM_PATH=/partner-services/health/premium
# ITGI_PROPOSAL_PATH=/partner-services/health/proposal
# ITGI_PAYMENT_INITIATE_PATH=/partner-services/transaction/initiate
# ITGI_PAYMENT_CONFIRMATION_PATH=/partner-services/payment/confirmation
# ITGI_POLICY_DOWNLOAD_PATH=/partner-services/policy/download
# ITGI_KYC_FETCH_PATH=/partner-services/kyc/fetch
# ITGI_KYC_CREATE_PATH=/partner-services/kyc/create

# ─── MySQL (journey break / resume persistence) ─────────────────────────────
# The journey tables live in the host Laravel application's schema, which owns
# the `users` table journeys attach to. NIVABUPA_DB_* takes precedence over DB_*
# if both are set — use the prefixed form on a host shared with other services.
#
# The service runs without a database: the eight Niva Bupa pass-through
# endpoints keep working, journeys simply are not saved or resumable.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=policy_db
DB_USERNAME=root
DB_PASSWORD=
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000

# ─── Journey lifecycle ──────────────────────────────────────────────────────
# How long a broken journey stays resumable. Long enough for a buyer who
# abandons at payment and returns the following weekend; short enough that a
# stale quote is not resumed at a price Niva Bupa would no longer honour.
JOURNEY_TTL_DAYS=7
# Idle journeys older than this are swept to ABANDONED for funnel reporting.
JOURNEY_ABANDON_AFTER_HOURS=48
JOURNEY_SWEEP_INTERVAL_MINUTES=60

# ─── Smoke tests only (scripts/) ────────────────────────────────────────────
# SMOKE_BASE_URL=http://localhost:4000
# SMOKE_MOBILE=9876500001
